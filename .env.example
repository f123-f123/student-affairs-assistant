# 复制本文件为 .env.local 后，填写下方必填值。不要把真实密钥写进 .env.example。
# 1. 数据库：共享部署用 Supabase；只有本地演示才改为 sqlite。
DB_PROVIDER=supabase
# Supabase Dashboard → Connect / Settings → API Keys 中的 Project URL。
# 形如 https://<project-ref>.supabase.co；不要填 postgresql:// 数据库连接串或 Studio URL。
SUPABASE_URL=
# Publishable key（sb_publishable_...）。当前项目没有浏览器直连 Supabase，此项暂不使用。
SUPABASE_PUBLISHABLE_KEY=
# 服务端使用 Secret key（sb_secret_...），不要填 Publishable/anon key。
# 仅放在本机 .env.local 或部署平台的服务端环境变量中，不加 NEXT_PUBLIC_ 前缀。
SUPABASE_SECRET_KEY=
# JWKS URL 用于验证 Supabase Auth JWT；本轮使用独立模拟会话，暂不使用。
# 正确变量名为 SUPABASE_JWKS_URL（不是 SUPABASE_JWKS_UR）。
SUPABASE_JWKS_URL=
# 仅旧项目没有 Secret key 时填写 legacy service_role key；有 Secret key 就留空。
SUPABASE_SERVICE_ROLE_KEY=

# 2. 大模型：问答、老师草稿生成、通知提取都需要真实的 LLM_API_KEY。
# 当前代码支持 deepseek 或 anthropic；使用 DeepSeek 时保持下面的 provider/model。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 3. 评估登录：passcode 用账号与老师口令；mock 用固定测试身份选择。两者均在页面明确标注模拟接入。
# passcode 需 TEACHER_PASSCODE；mock 必须留空 TEACHER_PASSCODE，默认只允许本地。
AUTH_MODE=passcode
# 长度至少 32 字符；仅由服务端读取。
SESSION_SECRET=
# 仅旧的 AUTH_MODE=mock 测试模式使用。
MOCK_AUTH_ALLOW_REMOTE=false
# 老师登录口令。受控评估时学生账号为 student-a 或 student-b，口令留空。
TEACHER_PASSCODE=

# 4. 网页通知与个人信息源共用允许域名；收藏链接不会改变白名单。逗号分隔，不写 https://。
ALLOWED_FETCH_DOMAINS=yunfeng.zju.edu.cn
# 默认为 system；Fake-IP 环境显式改为 doh。没有自动回退，也不会放行保留地址。
FETCH_DNS_MODE=system
# doh 模式支持 alidns 或 cloudflare；固定 HTTPS 服务及引导公网 IP，校验目标解析结果后再固定连接。
FETCH_DOH_PROVIDER=alidns
# 本地 SQLite 演示可选：不填则使用 data/demo.sqlite。
# LOCAL_SQLITE_PATH=data/demo.sqlite
